{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sipster",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sipster",
      "database_id": "8bc32e8a-7d61-4971-acdb-af630b58b9b5",
      "migrations_dir": "migrations"
    }
  ],
  // Check for due nudges every minute.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
  // VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are secrets: `npm run vapid` prints the commands.
}
