{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sipster",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Custom domain: Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "sipster.codesaif.dev", "custom_domain": true }],
  // Declaring routes turns workers.dev off by default, so keep it on explicitly.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, a navigation to /api/* (the sign-in link, Google's callback) gets the app's
    // index.html from the asset layer and the Worker never runs; fetches only reached it by luck.
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sipster",
      "database_id": "8bc32e8a-7d61-4971-acdb-af630b58b9b5",
      "migrations_dir": "migrations"
    }
  ],
  // Check for due nudges every minute.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
  // Secrets: VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY (`npm run vapid` prints the commands), and for
  // Sign in with Google GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (docs/DEPLOY.md, step 6).
}
