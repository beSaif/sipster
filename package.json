{
  "name": "sipster",
  "version": "0.1.0",
  "private": true,
  "description": "Drink water, feed Gerald. A pixel-hamster hydration reminder PWA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.ts",
    "vapid": "node scripts/gen-vapid.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p worker/tsconfig.json && tsc -p tsconfig.worker-test.json",
    "test": "vitest run",
    "worker:dev": "npm run build && wrangler dev --test-scheduled",
    "db:migrate": "wrangler d1 migrations apply sipster --remote",
    "deploy": "npm run build && wrangler deploy",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "db:migrate:local": "wrangler d1 migrations apply sipster --local"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.5",
    "http_ece": "^1.2.1",
    "playwright": "1.56.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.40.0"
  }
}
